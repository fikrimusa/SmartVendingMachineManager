<Window
    x:Class="SmartVendingMachineManager.Views.Main"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converter="clr-namespace:SmartVendingMachineManager.Converters"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    Title="Smart Vending Machine Manager - IoT Device Management Assessment"
    Width="1200"
    Height="800"
    MinWidth="800"
    MinHeight="600"
    Background="Black"
    WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <converter:StatusToColorConverter x:Key="StatusToColorConverter" />
        <converter:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <converter:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter" />
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="205.117" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.5*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Header Section  -->
        <Border
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Margin="0,0,0,10"
            Padding="12,7"
            Background="White"
            BorderBrush="Black"
            BorderThickness="1"
            CornerRadius="5">
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="24"
                FontWeight="Medium"
                Foreground="Black"
                Text="Smart Vending Machine Manager" />
        </Border>

        <!--  Vending Machine List Section  -->
        <Border
            Grid.Row="1"
            Grid.Column="0"
            Margin="0,0,10,10"
            Padding="1"
            Background="White"
            BorderBrush="Black"
            BorderThickness="1"
            CornerRadius="5">
            <DockPanel>
                <TextBlock
                    Margin="0,0,0,10"
                    Padding="10,5"
                    Background="DeepSkyBlue"
                    DockPanel.Dock="Top"
                    FontSize="15"
                    FontWeight="Medium"
                    Foreground="Black"
                    Text="List of Vending Machines" />
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible">
                    <!--  Machine List  -->
                    <ListBox
                        Margin="5"
                        BorderBrush="Transparent"
                        ItemsSource="{Binding Machines}"
                        SelectedItem="{Binding SelectedMachine}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="2"
                                    Padding="5"
                                    BorderBrush="Gray"
                                    BorderThickness="1"
                                    CornerRadius="3">
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="Black"
                                            Text="{Binding Location}" />
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse
                                                Width="10"
                                                Height="10"
                                                Margin="0,0,5,0"
                                                Fill="{Binding Status, Converter={StaticResource StatusToColorConverter}}" />
                                            <TextBlock
                                                FontSize="10"
                                                Foreground="Gray"
                                                Text="{Binding Status}" />
                                            <TextBlock
                                                FontSize="10"
                                                Foreground="Gray"
                                                Text=" • " />
                                            <TextBlock
                                                FontSize="10"
                                                FontWeight="SemiBold"
                                                Foreground="Blue"
                                                Text="{Binding TotalItems}" />
                                            <TextBlock
                                                FontSize="10"
                                                Foreground="Gray"
                                                Text="/" />
                                            <TextBlock
                                                FontSize="10"
                                                Foreground="Gray"
                                                Text="{Binding Capacity}" />
                                            <TextBlock
                                                FontSize="10"
                                                Foreground="Gray"
                                                Text=" items" />
                                            <TextBlock
                                                FontSize="10"
                                                Foreground="Gray"
                                                Text=" • " />
                                            <TextBlock
                                                FontSize="10"
                                                Foreground="Gray"
                                                Text="VMID:" />
                                            <TextBlock
                                                FontSize="10"
                                                Foreground="Gray"
                                                Text="{Binding MachineId}" />

                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!--  Add New Vending Machine Section  -->
        <Border
            Grid.Row="1"
            Grid.Column="1"
            Margin="0,0,0,10"
            Padding="1"
            Background="White"
            BorderBrush="Black"
            BorderThickness="1"
            CornerRadius="5">
            <StackPanel>
                <TextBlock
                    Margin="0,0,0,10"
                    Padding="10,5"
                    Background="DeepSkyBlue"
                    FontSize="15"
                    FontWeight="Medium"
                    Foreground="Black"
                    Text=" Add New Vending Machine" />
                <StackPanel Margin="10" Orientation="Vertical">
                    <!--  Location  -->
                    <TextBlock
                        Margin="0,0,0,2"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="Black"
                        Text="Location:" />
                    <TextBox
                        Margin="0,0,0,10"
                        Padding="5"
                        FontSize="12"
                        Text="{Binding NewMachineLocation, UpdateSourceTrigger=PropertyChanged}" />

                    <!--  Status  -->
                    <TextBlock
                        Margin="0,0,0,2"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="Black"
                        Text="Status:" />
                    <ComboBox
                        Margin="0,0,0,10"
                        Padding="5"
                        FontSize="12"
                        ItemsSource="{Binding StatusOptions}"
                        SelectedItem="{Binding NewMachineStatus}" />

                    <!--  Total Items  -->
                    <TextBlock
                        Margin="0,0,0,2"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="Black"
                        Text="Total Items:" />
                    <TextBox
                        Margin="0,0,0,10"
                        Padding="5"
                        FontSize="12"
                        Text="{Binding NewMachineTotalItems, UpdateSourceTrigger=PropertyChanged}" />

                    <!--  Capacity  -->
                    <TextBlock
                        Margin="0,0,0,2"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="Black"
                        Text="Capacity:" />
                    <TextBox
                        Margin="0,0,0,15"
                        Padding="5"
                        FontSize="12"
                        Text="{Binding NewMachineCapacity, UpdateSourceTrigger=PropertyChanged}" />

                    <!--  Add Button  -->
                    <Button
                        Padding="10,8"
                        HorizontalAlignment="Stretch"
                        Background="#27ae60"
                        Command="{Binding AddMachineCommand}"
                        Content="➕ ADD MACHINE"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="White" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!--  Details Panel Section  -->
        <Border
            Grid.Row="2"
            Grid.Column="0"
            Margin="0,0,10,0"
            Padding="1"
            Background="White"
            BorderBrush="Black"
            BorderThickness="1"
            CornerRadius="5">
            <StackPanel>
                <TextBlock
                    Margin="0,0,0,10"
                    Padding="10,5"
                    Background="DeepSkyBlue"
                    FontSize="15"
                    FontWeight="Medium"
                    Foreground="Black"
                    Text="Details Panel" />

                <GroupBox
                    Height="162"
                    Margin="1"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="Black"
                    Header="Selected Vending Machine Details">

                    <StackPanel Margin="5">
                        <!--  Show when no machine selected  -->
                        <TextBlock
                            VerticalAlignment="Center"
                            FontStyle="Italic"
                            Foreground="Gray"
                            Text="No machine selected. Choose a vending machine from the list."
                            TextAlignment="Center"
                            Visibility="{Binding SelectedMachine, Converter={StaticResource NullToVisibilityConverter}}" />

                        <!--  Show when machine is selected  -->
                        <StackPanel Orientation="Vertical" Visibility="{Binding SelectedMachine, Converter={StaticResource NotNullToVisibilityConverter}}">

                            <!--  Edit Location  -->
                            <TextBlock FontSize="11" Text="Location:" />
                            <TextBox
                                MinWidth="100"
                                Padding="0"
                                VerticalAlignment="Center"
                                Background="White"
                                BorderBrush="Black"
                                BorderThickness="1"
                                FontSize="10"
                                Foreground="DarkBlue"
                                Text="{Binding EditMachine.Location, UpdateSourceTrigger=PropertyChanged}" />

                            <!--  Edit Status  -->
                            <TextBlock FontSize="11" Text="Status:" />
                            <ComboBox
                                Padding="2"
                                Background="WhiteSmoke"
                                FontSize="10"
                                SelectedValue="{Binding EditMachine.Status}"
                                ToolTip="Edit status">
                                <sys:String>Online</sys:String>
                                <sys:String>Offline</sys:String>
                                <sys:String>Needs Restock</sys:String>
                                <sys:String>Maintenance Required</sys:String>
                            </ComboBox>

                            <!--  Edit Stock  -->
                            <TextBlock FontSize="11" Text="Stock:" />
                            <TextBox
                                MinWidth="100"
                                Padding="0"
                                VerticalAlignment="Center"
                                Background="White"
                                BorderBrush="Black"
                                BorderThickness="1"
                                FontSize="10"
                                Foreground="DarkBlue"
                                Text="{Binding EditMachine.TotalItems, UpdateSourceTrigger=PropertyChanged}" />

                            <!--  Edit Capacity  -->
                            <TextBlock FontSize="11" Text="Capacity:" />
                            <TextBox
                                MinWidth="100"
                                Padding="0"
                                VerticalAlignment="Center"
                                Background="White"
                                BorderBrush="Black"
                                BorderThickness="1"
                                FontSize="10"
                                Foreground="DarkBlue"
                                Text="{Binding EditMachine.Capacity, UpdateSourceTrigger=PropertyChanged}" />

                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!--  Update Button  -->
                <Button
                    Width="100"
                    Height="25"
                    Margin="0,-380,120,0"
                    Padding="0"
                    HorizontalAlignment="Right"
                    Background="DarkOrange"
                    Command="{Binding UpdateMachineCommand}"
                    Content="💾 Update Machine"
                    FontSize="12"
                    FontWeight="Bold"
                    Foreground="White" />

                <!--  Clear Selections Button  -->
                <Button
                    Width="100"
                    Height="25"
                    Margin="0,-380,5,0"
                    Padding="0"
                    HorizontalAlignment="Right"
                    Background="#95a5a6"
                    Command="{Binding ClearSelectionCommand}"
                    Content="Clear"
                    FontSize="12"
                    FontWeight="Bold"
                    Foreground="White" />

                <!--  Delete Selections Button  -->
                <Button
                    Width="100"
                    Height="25"
                    Margin="0,-380,230,0"
                    Padding="0"
                    HorizontalAlignment="Right"
                    Background="#e74c3c"
                    Command="{Binding DeleteMachineCommand}"
                    Content="🗑️ Delete"
                    FontSize="12"
                    FontWeight="Bold"
                    Foreground="White" />
            </StackPanel>
        </Border>

        <!--  Logs Section  -->
        <Border
            Grid.Row="2"
            Grid.Column="1"
            Padding="1"
            Background="White"
            BorderBrush="Black"
            BorderThickness="1"
            CornerRadius="5">
            <StackPanel>
                <TextBlock
                    Margin="0,0,0,0"
                    Padding="10,5"
                    Background="DeepSkyBlue"
                    FontSize="15"
                    FontWeight="Medium"
                    Foreground="Black"
                    Text="Activity Logs" />

                <ListBox
                    Height="160"
                    MaxHeight="200"
                    Margin="5"
                    Background="Transparent"
                    BorderThickness="0"
                    FontFamily="Consolas"
                    FontSize="10"
                    Foreground="Black"
                    ItemsSource="{Binding ActivityLogs}"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock
                                Margin="1"
                                Text="{Binding}"
                                TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>
    </Grid>
</Window>